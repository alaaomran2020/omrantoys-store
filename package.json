{
  "name": "omrantoys-store",
  "private": true,
  "version": "1.0.0",
  "description": "متجر عمران للألعاب - Omran Toys Store",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler dev",
    "cf:typegen": "wrangler types",
    "deploy": "npm run deploy:pages",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name=omrantoys-live-app --branch=main",
    "deploy:legacy-worker": "npm run build && wrangler deploy",
    "db:d1:migrate": "wrangler d1 migrations apply DB --local",
    "db:d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:d1:schema": "wrangler d1 execute DB --local --file=cloudflare/d1-schema.sql",
    "db:d1:tests": "wrangler d1 execute DB --local --file=cloudflare/d1-tests.sql",
    "db:d1:test": "bash cloudflare/test-d1.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}
