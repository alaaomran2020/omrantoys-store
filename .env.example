# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Paymob (https://accept.paymob.com)
VITE_PAYMOB_API_KEY=your-paymob-api-key
VITE_PAYMOB_INTEGRATION_ID=your-integration-id
VITE_PAYMOB_IFRAME_ID=your-iframe-id

# Fawry (https://developer.fawry.com)
VITE_FAWRY_MERCHANT_CODE=your-merchant-code
VITE_FAWRY_SECURITY_KEY=your-security-key

# Optional Analytics
VITE_GA4_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=XXXXXXXXXXXXXXX

# Store Info
VITE_WHATSAPP_NUMBER=201555570269

# ============================================================
# لوحة الإدارة المؤمَّنة (مصادقة واتساب) — أسرار تخص الـ Worker
# لا تُستخدم VITE_* هنا: تُضبط عبر `npx wrangler secret put <NAME>`
# ولا تُخزَّن في Git. محلياً ضعها في .dev.vars
#   AUTH_PEPPER            فلفل تشفير الـ hashes (إلزامي إنتاجياً)
#   AUTH_DEV_MODE=1        يعيد كود OTP في الاستجابة (تطوير فقط!)
#   WHATSAPP_PROVIDER=meta|dev
#   WHATSAPP_TOKEN         رمز الوصول الدائم من Meta
#   WHATSAPP_PHONE_NUMBER_ID
#   WHATSAPP_OTP_TEMPLATE  قالب authentication المعتمد
#   WHATSAPP_TEMPLATE_LANG=ar
#   WHATSAPP_VERIFY_TOKEN  رمز اشتراك الـ Webhook
#   WHATSAPP_APP_SECRET    سر التحقق من توقيع X-Hub-Signature-256
# التفاصيل: docs/whatsapp-auth-architecture.md
# ============================================================

